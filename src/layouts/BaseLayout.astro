---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";

export interface Props {
  title?: string;
  description?: string;
  activePage?: string;
}

const { title = "Radley Ciego", description: desc, activePage } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {desc && <meta name="description" content={desc} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script>
      // Prevent flash of wrong theme
      (function () {
        var key = "radleyciego-theme";
        var stored = localStorage.getItem(key);
        if (stored === "light" || stored === "dark") {
          document.documentElement.setAttribute("data-theme", stored);
        } else {
          var prefers = window.matchMedia("(prefers-color-scheme: dark)")
            .matches
            ? "dark"
            : "light";
          document.documentElement.setAttribute("data-theme", prefers);
        }
      })();
    </script>
  </head>
  <body>
    <div class="container">
      <nav class="nav">
        <div class="nav-inner">
          <a href="/" class={activePage === "index" ? "active" : ""}>Home</a>
          <a href="/resume" class={activePage === "resume" ? "active" : ""}
            >Resume</a
          >
        </div>
        <ThemeToggle />
      </nav>

      <main class="page">
        <slot />
      </main>

      <footer class="footer">
        <span>&copy; {new Date().getFullYear()} Radley Ciego</span>
        <span>
          <a href="https://github.com/radleyciego">GitHub</a>
          &middot;
          <a href="https://linkedin.com/in/radleykc">LinkedIn</a>
          &middot;
          <a href="mailto:radleykc@gmail.com">Email</a>
        </span>
      </footer>
    </div>
  </body>
</html>
